---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import { useTranslations } from "@i18n/utils";

const projects = (await getCollection("projects")).filter(
  (post) => !post.data.draft,
);

const data = [...projects];

const t = useTranslations(Astro.currentLocale);
const searchStrings = {
  placeholder: t("search.placeholder"),
  results: t("search.results"),
};
const cardStrings = {
  typePost: t("arrowcard.typePost"),
  typeNote: t("arrowcard.typeNote"),
  typeProject: t("arrowcard.typeProject"),
  updated: t("arrowcard.updated"),
  new: t("arrowcard.new"),
};
---

<PageLayout title={t("search.title")} description={t("search.description")}>
  <TopLayout>
    <div class="animate page-heading">
      {t("search.title")}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search
        client:load
        data={data}
        strings={searchStrings}
        cardStrings={cardStrings}
      />
    </div>
  </BottomLayout>
</PageLayout>
