---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import { SEARCH } from "@consts";
import { useTranslations } from "@i18n/utils";

const posts = (await getCollection("garden")).filter(
  (post) => !post.data.draft,
);

const notes = (await getCollection("notes")).filter((post) => !post.data.draft);

const projects = (await getCollection("projects")).filter(
  (post) => !post.data.draft,
);

const data = [...posts, ...notes, ...projects];

const t = useTranslations(Astro.currentLocale);
const searchStrings = {
  placeholder: t("search.placeholder"),
  results: t("search.results"),
};
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {SEARCH.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search client:load data={data} strings={searchStrings} />
    </div>
  </BottomLayout>
</PageLayout>
