---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Projects from "@components/Projects";
import { useTranslations, getCardStrings } from "@i18n/utils";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tags = [
  ...new Set(projects.flatMap((project) => project.data.tags)),
].sort((a, b) => a.localeCompare(b));

const t = useTranslations(Astro.currentLocale);
const projectsStrings = {
  filter: t("projects.filter"),
  showing: t("projects.showing"),
  of: t("projects.of"),
  label: t("projects.label"),
  noResults: t("projects.noResults"),
};
const cardStrings = getCardStrings(t);
---

<PageLayout title={t("projects.title")} description={t("projects.description")}>
  <TopLayout>
    <div class="animate page-heading">
      {t("projects.title")}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Projects
        client:load
        tags={tags}
        data={projects}
        strings={projectsStrings}
        cardStrings={cardStrings}
      />
    </div>
  </BottomLayout>
</PageLayout>
