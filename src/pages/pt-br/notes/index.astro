---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Garden from "@components/Garden";
import { useTranslations } from "@i18n/utils";

const posts = (await getCollection("notes"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const notesTags = ["seedling", "budding", "evergreen"];

const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .sort((a, b) => a.localeCompare(b))
  .filter((tag) => {
    return !notesTags.includes(tag);
  });

const t = useTranslations("pt-br");
const notesStrings = {
  filter: t("notes.filter"),
  sectionTags: t("notes.notesTags"),
  showing: t("notes.showing"),
  of: t("notes.of"),
  posts: t("notes.posts"),
  noResults: t("notes.noResults"),
};
---

<PageLayout title="Notas" description="Textos menores que textos.">
  <TopLayout>
    <div class="animate page-heading">Notas</div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Garden
        client:only="solid-js"
        tags={tags}
        data={posts}
        sectionTags={notesTags}
        strings={notesStrings}
      />
    </div>
  </BottomLayout>
</PageLayout>
