---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Garden from "@components/Garden";
import { useTranslations } from "@i18n/utils";

const posts = (await getCollection("garden"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const gardenTags = ["seedling", "budding", "evergreen"];

const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .sort((a, b) => a.localeCompare(b))
  .filter((tag) => {
    return !gardenTags.includes(tag);
  });

const t = useTranslations(Astro.currentLocale);
const gardenStrings = {
  filter: t("garden.filter"),
  sectionTags: t("garden.gardenTags"),
  showing: t("garden.showing"),
  of: t("garden.of"),
  posts: t("garden.posts"),
  noResults: t("garden.noResults"),
};
const cardStrings = {
  typePost: t("arrowcard.typePost"),
  typeNote: t("arrowcard.typeNote"),
  typeProject: t("arrowcard.typeProject"),
  updated: t("arrowcard.updated"),
  new: t("arrowcard.new"),
};
---

<PageLayout title={t("garden.title")} description={t("garden.description")}>
  <TopLayout>
    <div class="animate page-heading">{t("garden.title")}</div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Garden
        client:only="solid-js"
        tags={tags}
        data={posts}
        sectionTags={gardenTags}
        strings={gardenStrings}
        cardStrings={cardStrings}
      />
    </div>
  </BottomLayout>
</PageLayout>
