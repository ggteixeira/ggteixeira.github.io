---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Garden from "@components/Garden";
import { NOTES } from "@consts";

const posts = (await getCollection("notes"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const notesTags = ["seedling", "budding", "evergreen"];

const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .sort((a, b) => a.localeCompare(b))
  .filter((tag) => {
    return !notesTags.includes(tag);
  });

const notesStrings = {
  filter: "Filter",
  sectionTags: "Notes Tags",
  showing: "SHOWING",
  of: "OF",
  posts: "NOTES",
  noResults: "No notes match the selected filters.",
};
---

<PageLayout title={NOTES.TITLE} description={NOTES.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {NOTES.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Garden
        client:only="solid-js"
        tags={tags}
        data={posts}
        sectionTags={notesTags}
        strings={notesStrings}
      />
    </div>
  </BottomLayout>
</PageLayout>
